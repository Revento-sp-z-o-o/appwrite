+                    }
+                    $page = $users->list($queries, total: false)->users;
+                    foreach ($page as $user) {
+                        if ($transfer !== null && !isset($imported[Resource::TYPE_USER][$user->id])) {
+                            $cursor = $user->id;
+                            continue;
+                        }
+                        $target = $authorization->skip(fn () => $this->dbForProject->getDocument('users', $user->id));
+                        if ($target->isEmpty()) {
