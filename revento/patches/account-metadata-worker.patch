+                $cursor = null;
+                do {
+                    $queries = [AppwriteQuery::limit(100)];
+                    if ($cursor !== null) {
+                        $queries[] = AppwriteQuery::cursorAfter($cursor);
+                    }
+                    $page = $teams->list($queries, total: false)->teams;
+                    foreach ($page as $team) {
